RewriteEngine On
RewriteBase /

# /tabell/35 och /50000 servas av appen som bevarar sökvägen
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(tabell/\d+/?|\d+)/?$ index.html [L]

# Övriga okända sökvägar - även de applikationen (SPA-fallback)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
